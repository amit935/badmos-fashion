{{> header title="Verify Your Login" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text align="center" font-size="20px" font-family="Arial">
            Here is your One-Time Password
        </mj-text>
        
        <mj-text align="center" font-size="32px" font-weight="bold" color="#333" padding="20px">
            {{ otpCode }}
        </mj-text>
        
        <mj-text align="center" color="#555">
            This code will expire in 10 minutes. <br/>
            If you did not request this, please ignore this email.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}